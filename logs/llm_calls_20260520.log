"""Entry point for TestProject."""
from hello import greet, farewell
from utils import ensure_dir


def main() -> None:
    """Run the main application logic."""
    ensure_dir("/tmp/testproject_output")
    print(greet("World"))
    print(farewell("World"))


if __name__ == "__main__":
    main()


--- File Index 1: hello.py ---
"""Hello module for TestProject."""


def greet(name: str) -> str:
    """Return a greeting string for the given name."""
    return f"Hello, {name}!"


def farewell(name: str) -> str:
    """Return a farewell string for the given name."""
    return f"Goodbye, {name}!"


--- File Index 2: utils.py ---
"""Utility functions for TestProject."""
import os


def ensure_dir(path: str) -> None:
    """Create directory if it does not exist."""
    os.makedirs(path, exist_ok=True)


def read_file(path: str) -> str:
    """Read and return the contents of a file."""
    with open(path, "r") as f:
        return f.read()




